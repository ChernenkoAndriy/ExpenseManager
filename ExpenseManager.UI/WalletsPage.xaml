<Page x:Class="ExpenseManager.UI.WalletsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExpenseManager.UI"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WalletsPage">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="My Wallets" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <ListBox x:Name="WalletsListBox" Height="436" d:ItemsSource="{d:SampleData ItemCount=3}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" Width="700">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Currency}" Foreground="Gray" VerticalAlignment="Center"/>

                            <Button Grid.Column="3" 
                    Content="View Wallet Details" 
                    Padding="10,5" 
                    Click="ViewDetailsButton_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>
