<UserControl x:Class="ExpenseManager.UI.Views.WalletsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Мої гаманці" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button Content="+ Додати гаманець" Command="{Binding AddWalletCommand}" 
                    Background="#0078D7" Foreground="White" Padding="15,8" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Wallets}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Currency, Converter={StaticResource EnumConverter}}" Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Balance, StringFormat={}{0:N2}}" 
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0" TextAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Balance, Converter={StaticResource EnumConverter}, ConverterParameter=IsNegative}" Value="True">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Редагувати" 
            Command="{Binding DataContext.EditWalletCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
            CommandParameter="{Binding}" Padding="10,5" Margin="0,0,5,0" />

                                <Button Content="Деталі" 
            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
            CommandParameter="{Binding}" Padding="10,5" Margin="0,0,5,0" Background="#0078D7" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>