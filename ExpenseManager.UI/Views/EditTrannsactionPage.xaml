<UserControl x:Class="ExpenseManager.UI.Views.EditTransactionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редагування транзакції" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Grid.Row="0" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Сума (з мінусом для витрат)" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Категорія" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,25">
            <TextBlock Text="Опис" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="5"/>
        </StackPanel>

        <UniformGrid Grid.Row="4" Columns="2" HorizontalAlignment="Stretch">
            <Button Content="Скасувати" Command="{Binding CancelCommand}" Padding="10,8" Margin="0,0,5,0"/>
            <Button Content="Оновити" Command="{Binding SaveCommand}" Background="#0078D7" Foreground="White" Padding="10,8" Margin="5,0,0,0"/>
        </UniformGrid>
    </Grid>
</UserControl>