<Window x:Class="ExpenseManager.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ExpenseManager.UI.Views"
        xmlns:viewmodels="clr-namespace:ExpenseManager.UI.ViewModels"
        mc:Ignorable="d"
        Title="Expense Manager" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:WalletsViewModel}">
            <views:WalletsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WalletDetailsViewModel}">
            <views:WalletDetailsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EditWalletViewModel}">
            <views:EditWalletPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AddTransactionViewModel}">
            <views:AddTransactionPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TransactionDetailsViewModel}">
            <views:TransactionDetailsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding Navigation.CurrentViewModel}" />

        <Grid Background="#80000000" 
              Visibility="{Binding Navigation.CurrentViewModel.IsBusy, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
                <TextBlock Text="Завантаження..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>