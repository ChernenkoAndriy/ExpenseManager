<Window x:Class="ExpenseManager.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ExpenseManager.UI.ViewModels"
        xmlns:views="clr-namespace:ExpenseManager.UI.Views"
        Title="Expense Manager" Height="600" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WalletsViewModel}">
            <views:WalletsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WalletDetailsViewModel}">
            <views:WalletDetailsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditWalletViewModel}">
            <views:EditWalletPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddTransactionViewModel}">
            <views:AddTransactionPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionDetailsViewModel}">
            <views:TransactionDetailsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding Navigation.CurrentViewModel}" />
    </Grid>
</Window>